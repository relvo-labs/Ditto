{
  "manifest_version": 1,
  "id": "ditto.launcher.grid",
  "version": "1.2.2",
  "name": {
    "zh-TW": "網格式啟動器",
    "en": "Grid launcher"
  },
  "author": "Ditto",
  "license": "MIT",
  "source": "builtin",
  "description": {
    "zh-TW": "依類別瀏覽應用程式，或輸入文字搜尋全部類別；方向鍵選擇。",
    "en": "Browse apps by category or type to search all categories; arrow keys to choose."
  },
  "plugin_kind": "qml_provider",
  "host_kind": "qml",
  "trust_level": "trusted",
  "runtime": {
    "qt": ">=6.10"
  },
  "platform": [
    "linux-x86_64"
  ],
  "required_protocol_version": "^0.3",
  "slots": [
    "ui.launcher"
  ],
  "provides": [],
  "requires": [],
  "optional": [],
  "conflicts": [],
  "qml_entry": "qml/LauncherGrid.qml",
  "config_schema": {
    "type": "object",
    "properties": {},
    "additionalProperties": false
  },
  "commands": [
    {
      "id": "launcher.toggle",
      "title_key": "command.launcher.toggle"
    }
  ],
  "shortcuts": [],
  "events": [],
  "permissions": [],
  "hot_swap": "instant",
  "health": {
    "timeout_ms": 2000
  },
  "cleanup": {
    "timeout_ms": 5000
  },
  "migrations": [],
  "activation_events": [],
  "idle_policy": "resident",
  "resource_budget": {
    "memory_mib": 8
  },
  "rescue": {
    "disable_safe": true
  }
}
