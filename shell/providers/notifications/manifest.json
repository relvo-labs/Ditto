{
  "manifest_version": 1,
  "id": "ditto.notifications.area",
  "version": "1.1.0",
  "name": {
    "zh-TW": "通知區",
    "en": "Notification area"
  },
  "author": "Ditto",
  "license": "MIT",
  "source": "builtin",
  "description": {
    "zh-TW": "顯示、合併與關閉通知；規則由通知策略服務決定。",
    "en": "Shows, merges and dismisses notifications; the policy service decides the rules."
  },
  "plugin_kind": "qml_provider",
  "host_kind": "qml",
  "trust_level": "trusted",
  "runtime": {
    "qt": ">=6.10"
  },
  "platform": [
    "linux-x86_64"
  ],
  "required_protocol_version": "^0.3",
  "slots": [
    "ui.notifications"
  ],
  "provides": [],
  "requires": [],
  "optional": [
    {
      "capability": "desktop.notifications.policy.decide"
    }
  ],
  "conflicts": [],
  "qml_entry": "qml/NotificationArea.qml",
  "config_schema": {
    "type": "object",
    "properties": {
      "max_visible": {
        "type": "integer",
        "minimum": 1,
        "maximum": 8,
        "default": 3
      }
    },
    "additionalProperties": false
  },
  "commands": [],
  "shortcuts": [],
  "events": [],
  "permissions": [],
  "hot_swap": "instant",
  "health": {
    "timeout_ms": 2000
  },
  "cleanup": {
    "timeout_ms": 5000
  },
  "migrations": [],
  "activation_events": [],
  "idle_policy": "resident",
  "resource_budget": {
    "memory_mib": 8
  },
  "rescue": {
    "disable_safe": true
  }
}
