{
  "manifest_version": 1,
  "id": "ditto.dock.bottom",
  "version": "1.0.0",
  "name": {
    "zh-TW": "視窗列 Dock",
    "en": "Window list dock"
  },
  "author": "Ditto",
  "license": "UNLICENSED",
  "source": "builtin",
  "description": {
    "zh-TW": "底部置中，列出執行中的視窗。",
    "en": "Bottom-centred row of the running windows."
  },
  "plugin_kind": "qml_provider",
  "host_kind": "qml",
  "trust_level": "trusted",
  "runtime": {
    "qt": ">=6.10"
  },
  "platform": [
    "linux-x86_64"
  ],
  "required_protocol_version": "^0.2",
  "slots": [
    "ui.dock"
  ],
  "provides": [],
  "requires": [],
  "optional": [],
  "conflicts": [],
  "qml_entry": "qml/DockBottom.qml",
  "config_schema": {
    "type": "object",
    "properties": {},
    "additionalProperties": false
  },
  "commands": [],
  "shortcuts": [],
  "events": [],
  "permissions": [],
  "hot_swap": "instant",
  "health": {
    "timeout_ms": 2000
  },
  "cleanup": {
    "timeout_ms": 5000
  },
  "migrations": [],
  "activation_events": [],
  "idle_policy": "resident",
  "resource_budget": {
    "memory_mib": 8
  },
  "rescue": {
    "disable_safe": true
  }
}
