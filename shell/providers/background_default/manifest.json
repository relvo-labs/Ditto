{
  "manifest_version": 1,
  "id": "ditto.background.default",
  "version": "1.0.1",
  "name": {
    "zh-TW": "桌面背景",
    "en": "Desktop background"
  },
  "author": "Ditto",
  "license": "MIT",
  "source": "builtin",
  "plugin_kind": "qml_provider",
  "host_kind": "qml",
  "trust_level": "trusted",
  "runtime": {
    "qt": ">=6.10"
  },
  "platform": [
    "linux-x86_64"
  ],
  "required_protocol_version": "^0.3",
  "slots": [
    "ui.background"
  ],
  "provides": [],
  "requires": [],
  "optional": [],
  "conflicts": [],
  "qml_entry": "qml/Background.qml",
  "config_schema": {
    "type": "object",
    "properties": {},
    "additionalProperties": false
  },
  "commands": [],
  "shortcuts": [],
  "events": [],
  "permissions": [],
  "hot_swap": "instant",
  "health": {
    "timeout_ms": 2000
  },
  "cleanup": {
    "timeout_ms": 5000
  },
  "migrations": [],
  "activation_events": [],
  "idle_policy": "resident",
  "resource_budget": {
    "memory_mib": 8
  },
  "rescue": {
    "disable_safe": true
  }
}
