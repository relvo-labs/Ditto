[Unit]
Description=Recover interrupted Ditto first-boot account creation
# Must finish before sockets.target, rather than wait for basic.target.
DefaultDependencies=no
Requires=systemd-tmpfiles-setup.service
After=local-fs.target systemd-tmpfiles-setup.service
Before=sysinit.target sockets.target greetd.service shutdown.target
Conflicts=shutdown.target
RequiresMountsFor=/etc /home /var/lib/ditto/firstboot /var/mail

[Service]
Type=oneshot
RemainAfterExit=yes
User=root
Group=root
ExecStart=/usr/lib/ditto/ditto-firstboot-account --recover
TimeoutStartSec=120s
UMask=0077
ProtectSystem=strict
ReadWritePaths=/etc /home /var/lib/ditto/firstboot /var/mail
PrivateNetwork=yes
# PrivateTmp adds mount ordering; omit it in this early boot recovery unit.
PrivateDevices=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
LimitCORE=0
StandardInput=null
StandardOutput=null
StandardError=journal

[Install]
RequiredBy=greetd.service
WantedBy=sysinit.target
