[Unit]
Description=Release greeter sessions and select Ditto first-boot tty1
Wants=ditto-firstboot-account-recover.service
After=ditto-firstboot-account-recover.service greetd.service getty@tty1.service
Conflicts=greetd.service getty@tty1.service
OnFailure=greetd.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=root
Group=root
ExecStart=/usr/lib/ditto/ditto-firstboot-tty --prepare
TimeoutStartSec=25s
UMask=0077
ProtectSystem=strict
PrivateNetwork=yes
PrivateTmp=yes
PrivateDevices=no
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX
# This capability never reaches the separate account transaction unit.
CapabilityBoundingSet=CAP_SYS_TTY_CONFIG
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
LimitCORE=0
StandardInput=tty-force
StandardOutput=tty
StandardError=journal
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
SendSIGHUP=yes
KillMode=control-group
Restart=no
