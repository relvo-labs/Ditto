#!/usr/bin/env bash
# Display-manager entry point for the G0 reference session. Wayfire owns the
# session; Core then launches Quickshell through the controlled-launcher path.
#
# Wayfire, Core, Quickshell and Fcitx each run in a user scope of their own so
# the resource sampler can attribute them to a layer by cgroup (EX-05); the
# logind session scope keeps only the display manager's helpers. Wayfire still
# takes the seat from this session: libseat finds it through XDG_SESSION_ID.
# If the scoped compositor cannot start, it is started here directly so the
# login still works, and the sampler then reports the compositor unit missing
# instead of measuring the wrong thing. Those
# scopes do not end with the login session, so this script stops them when it
# exits and clears any a previous login left behind before it starts.
set -euo pipefail

workspace="${DITTO_WORKSPACE:-@DITTO_WORKSPACE@}"
qt_prefix="${DITTO_QT_PREFIX:-$HOME/Qt/6.10.2/gcc_64}"
wayfire_prefix="${DITTO_WAYFIRE_PREFIX:-$HOME/wayfire}"
core="$workspace/target/release/ditto-core"
wayfire_pid=""
core_pid=""
fcitx_config_home="$XDG_RUNTIME_DIR/ditto-g0-fcitx-config"
scopes=(ditto-g0-quickshell.scope ditto-g0-core.scope ditto-g0-fcitx.scope ditto-g0-wayfire.scope)

stop_scopes() {
  systemctl --user stop "${scopes[@]}" >/dev/null 2>&1 || true
}

cleanup() {
  trap - EXIT INT TERM HUP
  stop_scopes
  [[ -n "$wayfire_pid" ]] && kill "$wayfire_pid" 2>/dev/null || true
  wait 2>/dev/null || true
}
trap cleanup EXIT INT TERM HUP

[[ -x "$core" ]] || { echo "missing $core; run packaging/reference-image/install-session.sh" >&2; exit 1; }
[[ -x "$wayfire_prefix/bin/wayfire" ]] || { echo "missing frozen Wayfire" >&2; exit 1; }
[[ -x "$qt_prefix/bin/quickshell" ]] || { echo "missing frozen Quickshell" >&2; exit 1; }

export PATH="$wayfire_prefix/bin:$qt_prefix/bin:$HOME/.cargo/bin:$PATH"
export LD_LIBRARY_PATH="$wayfire_prefix/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export XDG_CURRENT_DESKTOP=Wayfire
export XDG_SESSION_DESKTOP=ditto-g0
export QT_QPA_PLATFORM=wayland
export QT_IM_MODULES=wayland
export QT_IM_MODULE=wayland
export XMODIFIERS=@im=fcitx
export _WAYFIRE_SOCKET="$XDG_RUNTIME_DIR/ditto-wayfire-ipc.sock"
export WAYFIRE_SOCKET="$_WAYFIRE_SOCKET"
unset DISPLAY SWAYSOCK
# A previous login can leave the fixed IPC pathname behind after an abort.
# Wayfire must create a fresh socket before Core starts probing it.
rm -f -- "$WAYFIRE_SOCKET"
# A login that ended without running cleanup (a display-manager restart, a
# SIGKILL) leaves its Core holding the socket, and the next Core would refuse
# to start. Nothing of an earlier Ditto session is still usable at this point.
stop_scopes

start_wayfire() {
  local marker
  marker="$(mktemp "$XDG_RUNTIME_DIR/ditto-g0-start.XXXXXX")"
  "$@" "$wayfire_prefix/bin/wayfire" --config "$workspace/packaging/reference-image/session/wayfire.ini" &
  wayfire_pid=$!
  socket=""
  for _ in $(seq 1 200); do
    socket="$(find "$XDG_RUNTIME_DIR" -maxdepth 1 -newer "$marker" -type s -name 'wayland-*' -print -quit)"
    [[ -n "$socket" && -S "$WAYFIRE_SOCKET" ]] && break
    socket=""
    kill -0 "$wayfire_pid" 2>/dev/null || break
    sleep 0.1
  done
  rm -f -- "$marker"
  [[ -n "$socket" ]]
}
if ! start_wayfire systemd-run --user --scope --quiet --collect --unit=ditto-g0-wayfire --; then
  echo 'Wayfire did not start in its own scope; starting it in the login session instead' >&2
  kill "$wayfire_pid" 2>/dev/null || true
  systemctl --user stop ditto-g0-wayfire.scope >/dev/null 2>&1 || true
  rm -f -- "$WAYFIRE_SOCKET"
  start_wayfire || { echo 'Wayfire stopped during login' >&2; exit 1; }
fi
export WAYLAND_DISPLAY="${socket##*/}"
# D-Bus-activated services (xdg-desktop-portal and its backends) start from the
# user manager, not from this script. Without the display they fail, and every
# portal client — the Firefox snap forces GTK_USE_PORTAL=1 — stalls on timeouts.
dbus-update-activation-environment --systemd \
  WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP QT_QPA_PLATFORM XMODIFIERS

install -d -m 0700 "$fcitx_config_home/fcitx5"
install -m 0600 "$workspace/tests/g0/input-method/fcitx5-profile" \
  "$fcitx_config_home/fcitx5/profile"
systemd-run --user --scope --quiet --collect --unit=ditto-g0-fcitx -- \
  env XDG_CONFIG_HOME="$fcitx_config_home" fcitx5 -d --replace

# EX-05 measures two more desktop states at login: the character off, and
# reduced motion. tests/g0/measure/cold-login.sh prepare writes this file; the
# Shell reads the result from its environment, so it holds for the whole login.
case "$(cat "${XDG_CONFIG_HOME:-$HOME/.config}/ditto-g0/measure-variant" 2>/dev/null || true)" in
  avatar-off) export DITTO_AVATAR=off ;;
  reduced-motion) export DITTO_REDUCED_MOTION=1 ;;
esac

systemd-run --user --scope --quiet --collect --unit=ditto-g0-core -- \
  env DITTO_LAUNCH_SCOPE_PREFIX=ditto-g0 "$core" serve --compositor wayfire \
  --launch "quickshell 0.3.1 $qt_prefix/bin/quickshell --no-color -p $workspace/shell/shell.qml" &
core_pid=$!
# Run in the background and wait, so a logout signal reaches the trap at once
# instead of after Core exits. Either Wayfire or Core ending ends the session.
wait -n "$wayfire_pid" "$core_pid" || true
