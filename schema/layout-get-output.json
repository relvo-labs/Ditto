{
  "$defs": {
    "HotSwapLevel": {
      "enum": [
        "instant",
        "controlled_handoff",
        "host_restart",
        "session_restart"
      ],
      "type": "string"
    },
    "LayoutMatch": {
      "additionalProperties": false,
      "properties": {
        "app_id": {
          "type": "string"
        }
      },
      "required": [
        "app_id"
      ],
      "type": "object"
    },
    "LayoutRule": {
      "additionalProperties": false,
      "properties": {
        "match": {
          "$ref": "#/$defs/LayoutMatch"
        },
        "workspace": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "match",
        "workspace"
      ],
      "type": "object"
    },
    "LayoutStrategyInfo": {
      "additionalProperties": false,
      "properties": {
        "hot_swap": {
          "$ref": "#/$defs/HotSwapLevel"
        },
        "name_key": {
          "type": "string"
        },
        "package": {
          "type": "string"
        },
        "runtime_switchable": {
          "description": "False when the compositor cannot switch it while running (C-15): the\nswitch is then scheduled for the next login and says so.",
          "type": "boolean"
        }
      },
      "required": [
        "package",
        "name_key",
        "hot_swap",
        "runtime_switchable"
      ],
      "type": "object"
    },
    "Region": {
      "additionalProperties": false,
      "description": "A rectangle as fractions (0–1) of an output's work area.",
      "properties": {
        "height": {
          "format": "double",
          "type": "number"
        },
        "width": {
          "format": "double",
          "type": "number"
        },
        "x": {
          "format": "double",
          "type": "number"
        },
        "y": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "type": "object"
    },
    "RegionRule": {
      "additionalProperties": false,
      "properties": {
        "match": {
          "$ref": "#/$defs/LayoutMatch"
        },
        "output": {
          "description": "The output whose work area the region divides; absent means the\noutput the window is on.",
          "type": [
            "string",
            "null"
          ]
        },
        "region": {
          "$ref": "#/$defs/Region"
        },
        "rule_id": {
          "description": "Stable within the Profile, so a later turn can name \"the same rule\".",
          "type": "string"
        }
      },
      "required": [
        "rule_id",
        "match",
        "region"
      ],
      "type": "object"
    },
    "RegionWindow": {
      "additionalProperties": false,
      "properties": {
        "app_id": {
          "type": "string"
        },
        "geometry": {
          "description": "`[x, y, width, height]` in output-relative logical pixels.",
          "items": {
            "format": "int64",
            "type": "integer"
          },
          "maxItems": 4,
          "minItems": 4,
          "type": [
            "array",
            "null"
          ]
        },
        "output": {
          "type": [
            "string",
            "null"
          ]
        },
        "rule_id": {
          "type": "string"
        },
        "window_id": {
          "type": "string"
        }
      },
      "required": [
        "rule_id",
        "window_id",
        "app_id"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "available": {
      "items": {
        "$ref": "#/$defs/LayoutStrategyInfo"
      },
      "type": "array"
    },
    "observed_strategy": {
      "type": [
        "string",
        "null"
      ]
    },
    "pending_next_login": {
      "description": "Session-restart changes waiting for the next login.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "region_windows": {
      "default": [],
      "items": {
        "$ref": "#/$defs/RegionWindow"
      },
      "type": "array"
    },
    "regions": {
      "default": [],
      "description": "Region rules of the Profile (D-40), with the open windows they cover\nand where those windows are now.",
      "items": {
        "$ref": "#/$defs/RegionRule"
      },
      "type": "array"
    },
    "rules": {
      "items": {
        "$ref": "#/$defs/LayoutRule"
      },
      "type": "array"
    },
    "strategy_entry": {
      "type": [
        "string",
        "null"
      ]
    },
    "strategy_package": {
      "type": [
        "string",
        "null"
      ]
    },
    "workspace_grid": {
      "items": {
        "format": "uint32",
        "minimum": 0,
        "type": "integer"
      },
      "maxItems": 2,
      "minItems": 2,
      "type": "array"
    }
  },
  "required": [
    "available",
    "workspace_grid",
    "rules",
    "pending_next_login"
  ],
  "title": "LayoutGetOutput",
  "type": "object"
}
