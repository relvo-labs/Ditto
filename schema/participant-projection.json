{
  "$defs": {
    "Appearance": {
      "additionalProperties": false,
      "properties": {
        "locale": {
          "type": "string"
        },
        "low_power_style": {
          "default": false,
          "description": "No blur and no shadow; NFR-05 measures it as its own style.",
          "type": "boolean"
        },
        "reduced_motion": {
          "default": false,
          "type": "boolean"
        },
        "reduced_transparency": {
          "default": false,
          "type": "boolean"
        },
        "theme": {
          "type": "string"
        },
        "tokens": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "type": "object"
        }
      },
      "required": [
        "theme",
        "locale"
      ],
      "type": "object"
    },
    "AvatarSettings": {
      "additionalProperties": false,
      "properties": {
        "animations": {
          "default": true,
          "type": "boolean"
        },
        "enabled": {
          "type": "boolean"
        },
        "hidden": {
          "default": false,
          "type": "boolean"
        },
        "scale": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "enabled",
        "scale"
      ],
      "type": "object"
    },
    "HostEntryProjection": {
      "additionalProperties": false,
      "properties": {
        "cleanup_timeout_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "config": true,
        "data_dir": {
          "type": "string"
        },
        "disabled": {
          "type": "boolean"
        },
        "entry_id": {
          "type": "string"
        },
        "file_grants": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "description": "File grants this entry holds, id → absolute path. The path is only\never sent to the process that holds the grant, never exported.",
          "type": "object"
        },
        "health_timeout_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "hot_swap": {
          "$ref": "#/$defs/HotSwapLevel"
        },
        "module_path": {
          "type": "string"
        },
        "package": {
          "type": "string"
        },
        "provides": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "entry_id",
        "package",
        "version",
        "module_path",
        "data_dir",
        "config",
        "disabled",
        "provides",
        "hot_swap",
        "health_timeout_ms",
        "cleanup_timeout_ms"
      ],
      "type": "object"
    },
    "HotSwapLevel": {
      "enum": [
        "instant",
        "controlled_handoff",
        "host_restart",
        "session_restart"
      ],
      "type": "string"
    },
    "LayoutIntent": {
      "additionalProperties": false,
      "description": "Layout intent. Which strategy applies is the `layout.strategy` slot.",
      "properties": {
        "rules": {
          "default": [],
          "items": {
            "$ref": "#/$defs/LayoutRule"
          },
          "type": "array"
        },
        "workspace_grid": {
          "items": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        }
      },
      "required": [
        "workspace_grid"
      ],
      "type": "object"
    },
    "LayoutMatch": {
      "additionalProperties": false,
      "properties": {
        "app_id": {
          "type": "string"
        }
      },
      "required": [
        "app_id"
      ],
      "type": "object"
    },
    "LayoutRule": {
      "additionalProperties": false,
      "properties": {
        "match": {
          "$ref": "#/$defs/LayoutMatch"
        },
        "workspace": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "match",
        "workspace"
      ],
      "type": "object"
    },
    "ShellSlotBinding": {
      "additionalProperties": false,
      "properties": {
        "config": true,
        "entry_id": {
          "type": "string"
        },
        "package": {
          "type": "string"
        },
        "qml_url": {
          "description": "`file://` URL of the provider's `qml_entry` inside the package store.",
          "type": "string"
        },
        "slot": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "slot",
        "entry_id",
        "package",
        "version",
        "qml_url",
        "config"
      ],
      "type": "object"
    },
    "ShortcutBinding": {
      "additionalProperties": false,
      "properties": {
        "chord": {
          "type": "string"
        },
        "command": {
          "type": "string"
        }
      },
      "required": [
        "chord",
        "command"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "appearance": {
          "$ref": "#/$defs/Appearance"
        },
        "avatar": {
          "$ref": "#/$defs/AvatarSettings"
        },
        "role": {
          "const": "shell",
          "type": "string"
        },
        "shortcuts": {
          "items": {
            "$ref": "#/$defs/ShortcutBinding"
          },
          "type": "array"
        },
        "slots": {
          "items": {
            "$ref": "#/$defs/ShellSlotBinding"
          },
          "type": "array"
        }
      },
      "required": [
        "role",
        "appearance",
        "avatar",
        "slots",
        "shortcuts"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "entries": {
          "items": {
            "$ref": "#/$defs/HostEntryProjection"
          },
          "type": "array"
        },
        "role": {
          "const": "hostd",
          "type": "string"
        }
      },
      "required": [
        "role",
        "entries"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "layout": {
          "$ref": "#/$defs/LayoutIntent"
        },
        "role": {
          "const": "compositor",
          "type": "string"
        },
        "shortcuts": {
          "items": {
            "$ref": "#/$defs/ShortcutBinding"
          },
          "type": "array"
        },
        "strategy": {
          "description": "Package of the `layout.strategy` provider.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "role",
        "layout",
        "shortcuts"
      ],
      "type": "object"
    }
  ],
  "title": "Projection"
}
