{
  "$defs": {
    "Appearance": {
      "additionalProperties": false,
      "properties": {
        "locale": {
          "type": "string"
        },
        "low_power_style": {
          "default": false,
          "description": "No blur and no shadow; NFR-05 measures it as its own style.",
          "type": "boolean"
        },
        "reduced_motion": {
          "default": false,
          "type": "boolean"
        },
        "reduced_transparency": {
          "default": false,
          "type": "boolean"
        },
        "theme": {
          "type": "string"
        },
        "tokens": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "type": "object"
        }
      },
      "required": [
        "theme",
        "locale"
      ],
      "type": "object"
    },
    "AppearanceToken": {
      "additionalProperties": false,
      "description": "One appearance token the Shell reads (`shell/jelly/Tokens.qml`).",
      "properties": {
        "default": {
          "description": "What the Shell uses while the Profile sets no value.",
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/TokenKind"
        },
        "max": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "min": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "kind",
        "default",
        "description"
      ],
      "type": "object"
    },
    "AvatarCorner": {
      "description": "Where on its output the character sits.",
      "enum": [
        "bottom_right",
        "bottom_left",
        "top_right",
        "top_left"
      ],
      "type": "string"
    },
    "AvatarPresentation": {
      "description": "An explicit rendering choice; absence retains the optional legacy avatar.",
      "enum": [
        "assistant"
      ],
      "type": "string"
    },
    "AvatarSettings": {
      "additionalProperties": false,
      "properties": {
        "animations": {
          "default": true,
          "type": "boolean"
        },
        "corner": {
          "$ref": "#/$defs/AvatarCorner",
          "description": "Which corner of that output the character sits in. A corner is always\ninside the visible area, whatever size the output has."
        },
        "enabled": {
          "type": "boolean"
        },
        "hidden": {
          "default": false,
          "type": "boolean"
        },
        "output": {
          "description": "The output the character stays on, by connector name. Absent means\nit follows the primary output; so does a named output that is not\nconnected (unplugged), until it comes back. Absent fields are left out\nof the document, so a Profile written before they existed keeps its\ndigest.",
          "type": [
            "string",
            "null"
          ]
        },
        "presentation": {
          "anyOf": [
            {
              "$ref": "#/$defs/AvatarPresentation"
            },
            {
              "type": "null"
            }
          ],
          "description": "D-48: absent preserves legacy rendering and its document digest.\nOlder readers reject this field; see the explicit downgrade policy."
        },
        "scale": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "enabled",
        "scale"
      ],
      "type": "object"
    },
    "TokenKind": {
      "description": "What an appearance token holds. Every token is stored as a string.",
      "oneOf": [
        {
          "const": "color",
          "description": "`#RRGGBB` or `#RRGGBBAA`.",
          "type": "string"
        },
        {
          "const": "number",
          "description": "A decimal number within `min`..=`max`, e.g. `\"1.2\"`.",
          "type": "string"
        },
        {
          "const": "text",
          "description": "Free text.",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "appearance": {
      "$ref": "#/$defs/Appearance"
    },
    "avatar": {
      "$ref": "#/$defs/AvatarSettings"
    },
    "profile_revision": {
      "type": "string"
    },
    "shell_applied": {
      "anyOf": [
        {
          "$ref": "#/$defs/Appearance"
        },
        {
          "type": "null"
        }
      ],
      "description": "What the Shell last reported as applied; `null` when no Shell reported."
    },
    "tokens_available": {
      "description": "Every token `desktop.appearance.set` accepts, with its kind, the\ndefault in effect while `appearance.tokens` has no value, and range.",
      "items": {
        "$ref": "#/$defs/AppearanceToken"
      },
      "type": "array"
    }
  },
  "required": [
    "appearance",
    "avatar",
    "profile_revision",
    "tokens_available"
  ],
  "title": "AppearanceGetOutput",
  "type": "object"
}
