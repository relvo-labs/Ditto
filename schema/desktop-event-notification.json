  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "payload": {
      "$ref": "#/$defs/DesktopEventPayload"
    },
    "revision": {
      "description": "Observation revision; no persistent Profile exists in G0.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "seq": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "subscription_id": {
      "type": "string"
    }
  },
  "required": [
    "subscription_id",
    "seq",
    "revision",
    "payload"
  ],
  "title": "DesktopEventNotification",
  "type": "object"
}
