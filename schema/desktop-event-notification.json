            }
          },
          "required": [
            "type",
            "reason"
          ],
          "type": "object"
        }
      ]
    },
    "Output": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "height": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "scale": {
          "format": "double",
          "type": "number"
        },
        "width": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "x": {
          "format": "int32",
          "type": "integer"
        },
        "y": {
          "format": "int32",
          "type": "integer"
        }
