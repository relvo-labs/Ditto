        "title": {
          "type": "string"
        },
        "width": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "workspace_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "x": {
          "format": "int32",
          "type": [
            "integer",
            "null"
          ]
        },
        "y": {
          "format": "int32",
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "title",
        "app_id",
        "focused",
        "state"
      ],
      "type": "object"
