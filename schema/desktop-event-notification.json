            "type",
            "window"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "window_removed",
              "type": "string"
            },
            "window_id": {
              "$ref": "#/$defs/WindowSessionId"
            }
          },
          "required": [
            "type",
            "window_id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "workspace_upsert",
              "type": "string"
            },
            "workspace": {
              "$ref": "#/$defs/Workspace"
            }
          },
          "required": [
            "type",
            "workspace"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "workspace_removed",
              "type": "string"
            },
            "workspace_id": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "workspace_id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "output": {
              "$ref": "#/$defs/Output"
            },
            "type": {
              "const": "output_upsert",
              "type": "string"
            }
          },
          "required": [
            "type",
            "output"
          ],
          "type": "object"
        },
        {
          "properties": {
            "output_name": {
              "type": "string"
            },
            "type": {
              "const": "output_removed",
              "type": "string"
            }
          },
          "required": [
            "type",
            "output_name"
          ],
          "type": "object"
        },
        {
          "properties": {
            "reason": {
              "type": "string"
            },
            "type": {
              "const": "resync_required",
