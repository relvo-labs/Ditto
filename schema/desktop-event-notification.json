{
  "$defs": {
    "ChangeOrigin": {
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "gui",
              "type": "string"
            },
            "surface": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "cli",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "agent_standin",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "rescue",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "supervisor",
              "type": "string"
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "reason"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "timed_revert",
              "type": "string"
            },
            "reverts": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "reverts"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "undo",
              "type": "string"
            },
            "undoes": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "undoes"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "import",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "ChangeState": {
      "enum": [
        "draft",
        "validated",
        "rejected",
        "prepared",
        "aborted",
        "applying",
        "verifying",
        "committed",
        "rolling_back",
        "rolled_back",
        "partially_applied",
        "unknown"
      ],
      "type": "string"
    },
    "ChangeSummary": {
      "additionalProperties": false,
      "properties": {
        "change_id": {
          "type": "string"
        },
        "committed_revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "confirmation": {
          "$ref": "#/$defs/Confirmation"
        },
        "created_at": {
          "type": "string"
        },
        "hot_swap_level": {
          "$ref": "#/$defs/HotSwapLevel"
        },
        "origin": {
          "$ref": "#/$defs/ChangeOrigin"
        },
        "profile_id": {
          "type": "string"
        },
        "result": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResultKind"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "$ref": "#/$defs/ChangeState"
        },
        "title_key": {
          "type": "string"
        },
        "updated_at": {
          "type": "string"
        }
      },
      "required": [
        "change_id",
        "profile_id",
        "state",
        "origin",
        "hot_swap_level",
        "title_key",
        "confirmation",
        "created_at",
        "updated_at"
      ],
      "type": "object"
    },
    "Confirmation": {
      "oneOf": [
        {
          "properties": {
            "state": {
              "const": "not_required",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        },
        {
          "properties": {
            "deadline": {
              "type": "string"
            },
            "state": {
              "const": "pending",
              "type": "string"
            }
          },
          "required": [
            "state",
            "deadline"
          ],
          "type": "object"
        },
        {
          "properties": {
            "at": {
              "type": "string"
            },
            "state": {
              "const": "confirmed",
              "type": "string"
            }
          },
          "required": [
            "state",
            "at"
          ],
          "type": "object"
        },
        {
          "properties": {
            "by_change": {
              "type": "string"
            },
            "state": {
              "const": "reverted",
              "type": "string"
            }
          },
          "required": [
            "state",
            "by_change"
          ],
          "type": "object"
        }
      ]
    },
    "DesktopEventPayload": {
      "oneOf": [
        {
          "properties": {
            "type": {
              "const": "window_upsert",
              "type": "string"
            },
            "window": {
              "$ref": "#/$defs/Window"
            }
          },
          "required": [
            "type",
            "window"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "window_removed",
              "type": "string"
            },
            "window_id": {
              "$ref": "#/$defs/WindowSessionId"
            }
          },
          "required": [
            "type",
            "window_id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "workspace_upsert",
              "type": "string"
            },
            "workspace": {
              "$ref": "#/$defs/Workspace"
            }
          },
          "required": [
            "type",
            "workspace"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "workspace_removed",
              "type": "string"
            },
            "workspace_id": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "workspace_id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "output": {
              "$ref": "#/$defs/Output"
            },
            "type": {
              "const": "output_upsert",
              "type": "string"
            }
          },
          "required": [
            "type",
            "output"
          ],
          "type": "object"
        },
        {
          "properties": {
            "output_name": {
              "type": "string"
            },
            "type": {
              "const": "output_removed",
              "type": "string"
            }
          },
          "required": [
            "type",
            "output_name"
          ],
          "type": "object"
        },
        {
          "properties": {
            "reason": {
              "type": "string"
            },
            "type": {
              "const": "resync_required",
              "type": "string"
            }
          },
          "required": [
            "type",
            "reason"
          ],
          "type": "object"
        },
        {
          "properties": {
            "active": {
              "type": "boolean"
            },
            "head_revision": {
              "type": "string"
            },
            "profile_id": {
              "type": "string"
            },
            "type": {
              "const": "profile_changed",
              "type": "string"
            }
          },
          "required": [
            "type",
            "profile_id",
            "head_revision",
            "active"
          ],
          "type": "object"
        },
        {
          "properties": {
            "change": {
              "$ref": "#/$defs/ChangeSummary"
            },
            "type": {
              "const": "change_updated",
              "type": "string"
            }
          },
          "required": [
            "type",
            "change"
          ],
          "type": "object"
        },
        {
          "properties": {
            "reason": {
              "type": "string"
            },
            "type": {
              "const": "capabilities_changed",
              "type": "string"
            }
          },
          "required": [
            "type",
            "reason"
          ],
          "type": "object"
        },
        {
          "properties": {
            "panels": {
              "items": {
                "$ref": "#/$defs/PanelStatus"
              },
              "type": "array"
            },
            "type": {
              "const": "panels_changed",
              "type": "string"
            }
          },
          "required": [
            "type",
            "panels"
          ],
          "type": "object"
        },
        {
          "properties": {
            "job": {
              "$ref": "#/$defs/Job"
            },
            "type": {
              "const": "jobs_updated",
              "type": "string"
            }
          },
          "required": [
            "type",
            "job"
          ],
          "type": "object"
        },
        {
          "properties": {
            "notification": {
              "$ref": "#/$defs/NotificationItem"
            },
            "type": {
              "const": "notification_posted",
              "type": "string"
            }
          },
          "required": [
            "type",
            "notification"
          ],
          "type": "object"
        },
        {
          "properties": {
            "id": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "reason": {
              "type": "string"
            },
            "type": {
              "const": "notification_closed",
              "type": "string"
            }
          },
          "required": [
            "type",
            "id",
            "reason"
          ],
          "type": "object"
        },
        {
          "description": "A cross-process event a hostd entry declared in its manifest.",
          "properties": {
            "entry_id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "payload": true,
            "type": {
              "const": "host_event",
              "type": "string"
            }
          },
          "required": [
            "type",
            "entry_id",
            "name",
            "payload"
          ],
          "type": "object"
        },
        {
          "properties": {
            "state": {
              "$ref": "#/$defs/SessionState"
            },
            "type": {
              "const": "session_changed",
              "type": "string"
            }
          },
          "required": [
            "type",
            "state"
          ],
          "type": "object"
        }
      ]
    },
    "HotSwapLevel": {
      "enum": [
        "instant",
        "controlled_handoff",
        "host_restart",
        "session_restart"
      ],
      "type": "string"
    },
    "Job": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "type": "string"
        },
        "error_key": {
          "type": [
            "string",
            "null"
          ]
        },
        "idempotency_key": {
          "type": [
            "string",
            "null"
          ]
        },
        "job_id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "progress": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "result": true,
        "state": {
          "$ref": "#/$defs/JobState"
        },
        "updated_at": {
          "type": "string"
        }
      },
      "required": [
        "job_id",
        "kind",
        "state",
        "created_at",
        "updated_at"
      ],
      "type": "object"
    },
    "JobState": {
      "enum": [
        "queued",
        "running",
        "succeeded",
        "failed",
        "cancelled"
      ],
      "type": "string"
    },
    "NotificationItem": {
      "additionalProperties": false,
      "properties": {
        "app_name": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "created_at": {
          "type": "string"
        },
        "decision": {
          "$ref": "#/$defs/PolicyDecision"
        },
        "id": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "merged_count": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "policy_unavailable": {
          "description": "Set when the policy could not be asked: the notification is shown and\nthe area says rules are unavailable (failing open to display).",
          "type": "boolean"
        },
        "summary": {
          "type": "string"
        },
        "urgency": {
          "$ref": "#/$defs/Urgency"
        }
      },
      "required": [
        "id",
        "app_name",
        "summary",
        "body",
        "urgency",
        "decision",
        "policy_unavailable",
        "merged_count",
        "created_at"
      ],
      "type": "object"
    },
    "Output": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "height": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "scale": {
          "format": "double",
          "type": "number"
        },
        "width": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "x": {
          "format": "int32",
          "type": "integer"
        },
        "y": {
          "format": "int32",
          "type": "integer"
        }
      },
      "required": [
        "name",
        "width",
        "height",
        "scale",
        "x",
        "y",
        "enabled"
      ],
      "type": "object"
    },
    "PanelStatus": {
      "additionalProperties": false,
      "properties": {
        "bound_entry": {
          "type": [
            "string",
            "null"
          ]
        },
        "mounted": {
          "type": "boolean"
        },
        "mounted_entry": {
          "type": [
            "string",
            "null"
          ]
        },
        "package": {
          "type": [
            "string",
            "null"
          ]
        },
        "slot": {
          "type": "string"
        },
        "visible": {
          "type": "boolean"
        }
      },
      "required": [
        "slot",
        "mounted",
        "visible"
      ],
      "type": "object"
    },
    "PolicyDecision": {
      "enum": [
        "show",
        "merge",
        "silence"
      ],
      "type": "string"
    },
    "ResultKind": {
      "oneOf": [
        {
          "enum": [
            "succeeded",
            "failed",
            "partial",
            "unknown"
          ],
          "type": "string"
        },
        {
          "const": "scheduled",
          "description": "Committed as a revision, but nothing took effect yet: every item is\n`scheduled` (session-restart level: at the next login; in rescue mode:\nwhen the normal mode returns). Never presented as \"applied\".",
          "type": "string"
        }
      ]
    },
    "SessionState": {
      "additionalProperties": false,
      "properties": {
        "lock_client_running": {
          "type": "boolean"
        },
        "locked": {
          "type": "boolean"
        },
        "logind_available": {
          "type": "boolean"
        },
        "preparing_for_sleep": {
          "type": "boolean"
        }
      },
      "required": [
        "locked",
        "lock_client_running",
        "preparing_for_sleep",
        "logind_available"
      ],
      "type": "object"
    },
    "Urgency": {
      "enum": [
        "low",
        "normal",
        "critical"
      ],
      "type": "string"
    },
    "Window": {
      "additionalProperties": false,
      "properties": {
        "app_id": {
          "type": "string"
        },
        "focused": {
          "type": "boolean"
        },
        "height": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "id": {
          "$ref": "#/$defs/WindowSessionId"
        },
        "state": {
          "$ref": "#/$defs/WindowState"
        },
        "title": {
          "type": "string"
        },
        "width": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "workspace_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "x": {
          "format": "int32",
          "type": [
            "integer",
            "null"
          ]
        },
        "y": {
          "format": "int32",
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "title",
        "app_id",
        "focused",
        "state"
      ],
      "type": "object"
    },
    "WindowSessionId": {
      "description": "An opaque identifier valid only for the current compositor session.",
      "type": "string"
    },
    "WindowState": {
      "enum": [
        "normal",
        "minimized",
        "maximized",
        "fullscreen"
      ],
      "type": "string"
    },
    "Workspace": {
      "additionalProperties": false,
      "properties": {
        "active": {
          "type": "boolean"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "active"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "payload": {
      "$ref": "#/$defs/DesktopEventPayload"
    },
    "prev_seq": {
      "description": "The `seq` of the previous event delivered to this subscription (or the\nsubscription's starting `seq`). A consumer detects a lost event when it\ndiffers from the last `seq` it saw: topics it did not ask for leave\ngaps in `seq`, never in this chain.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "profile_revision": {
      "description": "The active Profile head when the event was published; `null` before\nCore has loaded a Profile. 0.1 called an observation counter `revision`.",
      "type": [
        "string",
        "null"
      ]
    },
    "seq": {
      "description": "Position in Core's single event stream, shared by every topic; the\nvalue to pass as `after_seq` when resubscribing.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "subscription_id": {
      "type": "string"
    }
  },
  "required": [
    "subscription_id",
    "seq",
    "prev_seq",
    "payload"
  ],
  "title": "DesktopEventNotification",
  "type": "object"
}
