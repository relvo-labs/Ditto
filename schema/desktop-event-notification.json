        "height",
        "scale",
        "x",
        "y",
        "enabled"
      ],
      "type": "object"
    },
    "Window": {
      "additionalProperties": false,
      "properties": {
        "app_id": {
          "type": "string"
        },
        "focused": {
          "type": "boolean"
        },
        "height": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "id": {
          "$ref": "#/$defs/WindowSessionId"
