{
  "$defs": {
    "Appearance": {
      "additionalProperties": false,
      "properties": {
        "locale": {
          "type": "string"
        },
        "low_power_style": {
          "default": false,
          "description": "No blur and no shadow; NFR-05 measures it as its own style.",
          "type": "boolean"
        },
        "reduced_motion": {
          "default": false,
          "type": "boolean"
        },
        "reduced_transparency": {
          "default": false,
          "type": "boolean"
        },
        "theme": {
          "type": "string"
        },
        "tokens": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "type": "object"
        }
      },
      "required": [
        "theme",
        "locale"
      ],
      "type": "object"
    },
    "AvatarCorner": {
      "description": "Where on its output the character sits.",
      "enum": [
        "bottom_right",
        "bottom_left",
        "top_right",
        "top_left"
      ],
      "type": "string"
    },
    "AvatarSettings": {
      "additionalProperties": false,
      "properties": {
        "animations": {
          "default": true,
          "type": "boolean"
        },
        "corner": {
          "$ref": "#/$defs/AvatarCorner",
          "description": "Which corner of that output the character sits in. A corner is always\ninside the visible area, whatever size the output has."
        },
        "enabled": {
          "type": "boolean"
        },
        "hidden": {
          "default": false,
          "type": "boolean"
        },
        "output": {
          "description": "The output the character stays on, by connector name. Absent means\nit follows the primary output; so does a named output that is not\nconnected (unplugged), until it comes back. Absent fields are left out\nof the document, so a Profile written before they existed keeps its\ndigest.",
          "type": [
            "string",
            "null"
          ]
        },
        "scale": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "enabled",
        "scale"
      ],
      "type": "object"
    },
    "EntrySpec": {
      "additionalProperties": false,
      "properties": {
        "config": {
          "default": {}
        },
        "disabled": {
          "default": false,
          "type": "boolean"
        },
        "entry_id": {
          "description": "`ent-<ULID>`, generated by Core and stable across revisions: without a\nstable id every edit would look like a removal plus an addition.",
          "type": "string"
        },
        "host": {
          "$ref": "#/$defs/HostKind"
        },
        "package": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "entry_id",
        "package",
        "version",
        "host"
      ],
      "type": "object"
    },
    "HostKind": {
      "enum": [
        "qml",
        "cordis",
        "core_builtin"
      ],
      "type": "string"
    },
    "LayoutIntent": {
      "additionalProperties": false,
      "description": "Layout intent. Which strategy applies is the `layout.strategy` slot.",
      "properties": {
        "rules": {
          "default": [],
          "items": {
            "$ref": "#/$defs/LayoutRule"
          },
          "type": "array"
        },
        "workspace_grid": {
          "items": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        }
      },
      "required": [
        "workspace_grid"
      ],
      "type": "object"
    },
    "LayoutMatch": {
      "additionalProperties": false,
      "properties": {
        "app_id": {
          "type": "string"
        }
      },
      "required": [
        "app_id"
      ],
      "type": "object"
    },
    "LayoutRule": {
      "additionalProperties": false,
      "properties": {
        "match": {
          "$ref": "#/$defs/LayoutMatch"
        },
        "workspace": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "match",
        "workspace"
      ],
      "type": "object"
    },
    "PackageLock": {
      "additionalProperties": false,
      "properties": {
        "package": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "package",
        "version",
        "sha256"
      ],
      "type": "object"
    },
    "ProfileDocument": {
      "additionalProperties": false,
      "properties": {
        "appearance": {
          "$ref": "#/$defs/Appearance"
        },
        "avatar": {
          "$ref": "#/$defs/AvatarSettings"
        },
        "entries": {
          "items": {
            "$ref": "#/$defs/EntrySpec"
          },
          "type": "array"
        },
        "layout": {
          "$ref": "#/$defs/LayoutIntent"
        },
        "schema_version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "shortcuts": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ShortcutBinding"
          },
          "type": "array"
        },
        "slots": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "slot name → entry id.",
          "type": "object"
        }
      },
      "required": [
        "schema_version",
        "entries",
        "slots",
        "layout",
        "appearance",
        "avatar"
      ],
      "type": "object"
    },
    "ProfileExport": {
      "additionalProperties": false,
      "description": "A portable Profile: document, package locks and schema version. It never\ncarries plugin data, the paths behind file grants, or secrets.",
      "properties": {
        "document": {
          "$ref": "#/$defs/ProfileDocument"
        },
        "document_sha256": {
          "type": "string"
        },
        "format": {
          "type": "string"
        },
        "format_version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "packages": {
          "items": {
            "$ref": "#/$defs/PackageLock"
          },
          "type": "array"
        },
        "profile_name": {
          "type": "string"
        },
        "protocol_version": {
          "type": "string"
        },
        "redacted": {
          "default": [],
          "description": "JSON pointers whose values were removed because they looked like a\nprivate path or a secret; the export never carries them.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "required_grants": {
          "description": "Grant references the document used; the importer has to grant again.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "format",
        "format_version",
        "protocol_version",
        "profile_name",
        "document",
        "document_sha256",
        "packages",
        "required_grants"
      ],
      "type": "object"
    },
    "ShortcutBinding": {
      "additionalProperties": false,
      "properties": {
        "chord": {
          "type": "string"
        },
        "command": {
          "type": "string"
        }
      },
      "required": [
        "chord",
        "command"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "export": {
      "$ref": "#/$defs/ProfileExport"
    }
  },
  "required": [
    "export"
  ],
  "title": "ProfilesExportOutput",
  "type": "object"
}
