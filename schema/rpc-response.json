{
  "$defs": {
    "ErrorName": {
      "enum": [
        "unsupported",
        "invalid_params",
        "not_found",
        "permission_denied",
        "timeout",
        "cancelled",
        "conflict",
        "unavailable",
        "protocol_version_unsupported",
        "identity_rejected",
        "internal"
      ],
      "type": "string"
    },
    "Outcome": {
      "enum": [
        "unknown"
      ],
      "type": "string"
    },
    "RpcError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "format": "int32",
          "type": "integer"
        },
        "message": {
          "type": "string"
        },
        "name": {
          "$ref": "#/$defs/ErrorName"
        },
        "outcome": {
          "anyOf": [
            {
              "$ref": "#/$defs/Outcome"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "code",
        "name",
        "message"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/RpcError"
        },
        {
          "type": "null"
        }
      ]
    },
    "id": {
      "type": "string"
    },
    "jsonrpc": {
      "type": "string"
    },
    "result": true
  },
  "required": [
    "jsonrpc",
    "id"
  ],
  "title": "RpcResponse",
  "type": "object"
}
