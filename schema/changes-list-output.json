{
  "$defs": {
    "ChangeOrigin": {
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "gui",
              "type": "string"
            },
            "surface": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "cli",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "agent_standin",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "agent",
              "type": "string"
            },
            "session_id": {
              "type": "string"
            },
            "tool_call_id": {
              "type": "string"
            },
            "turn_id": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "session_id",
            "turn_id",
            "tool_call_id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "rescue",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "supervisor",
              "type": "string"
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "reason"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "timed_revert",
              "type": "string"
            },
            "reverts": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "reverts"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "undo",
              "type": "string"
            },
            "undoes": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "undoes"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "import",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "ChangeState": {
      "enum": [
        "draft",
        "validated",
        "rejected",
        "prepared",
        "aborted",
        "applying",
        "verifying",
        "committed",
        "rolling_back",
        "rolled_back",
        "partially_applied",
        "unknown"
      ],
      "type": "string"
    },
    "ChangeSummary": {
      "additionalProperties": false,
      "properties": {
        "change_id": {
          "type": "string"
        },
        "committed_revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "confirmation": {
          "$ref": "#/$defs/Confirmation"
        },
        "created_at": {
          "type": "string"
        },
        "hot_swap_level": {
          "$ref": "#/$defs/HotSwapLevel"
        },
        "origin": {
          "$ref": "#/$defs/ChangeOrigin"
        },
        "profile_id": {
          "type": "string"
        },
        "result": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResultKind"
            },
            {
              "type": "null"
            }
          ]
        },
        "saved_only": {
          "anyOf": [
            {
              "$ref": "#/$defs/SavedOnly"
            },
            {
              "type": "null"
            }
          ],
          "description": "As on [`ChangeRecord::saved_only`]."
        },
        "state": {
          "$ref": "#/$defs/ChangeState"
        },
        "title_key": {
          "type": "string"
        },
        "updated_at": {
          "type": "string"
        }
      },
      "required": [
        "change_id",
        "profile_id",
        "state",
        "origin",
        "hot_swap_level",
        "title_key",
        "confirmation",
        "created_at",
        "updated_at"
      ],
      "type": "object"
    },
    "Confirmation": {
      "oneOf": [
        {
          "properties": {
            "state": {
              "const": "not_required",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        },
        {
          "properties": {
            "deadline": {
              "type": "string"
            },
            "state": {
              "const": "pending",
              "type": "string"
            }
          },
          "required": [
            "state",
            "deadline"
          ],
          "type": "object"
        },
        {
          "properties": {
            "at": {
              "type": "string"
            },
            "state": {
              "const": "confirmed",
              "type": "string"
            }
          },
          "required": [
            "state",
            "at"
          ],
          "type": "object"
        },
        {
          "properties": {
            "by_change": {
              "type": "string"
            },
            "state": {
              "const": "reverted",
              "type": "string"
            }
          },
          "required": [
            "state",
            "by_change"
          ],
          "type": "object"
        }
      ]
    },
    "HotSwapLevel": {
      "enum": [
        "instant",
        "controlled_handoff",
        "host_restart",
        "session_restart"
      ],
      "type": "string"
    },
    "ResultKind": {
      "oneOf": [
        {
          "enum": [
            "succeeded",
            "failed",
            "partial",
            "unknown"
          ],
          "type": "string"
        },
        {
          "const": "scheduled",
          "description": "Committed as a revision, but nothing took effect yet: every item is\n`scheduled` (session-restart level: at the next login; in rescue mode:\nwhen the normal mode returns). Never presented as \"applied\".",
          "type": "string"
        }
      ]
    },
    "SavedOnly": {
      "additionalProperties": false,
      "description": "A committed change that wrote its Profile's revision and applied nothing\nto the desktop (protocol 0.2 §8.1). `result` stays `succeeded`: the edit\nof the stored Profile is done; this says where it went.",
      "properties": {
        "profile_name": {
          "description": "The Profile's name when the record is read (it can be renamed since).",
          "type": "string"
        },
        "reason": {
          "$ref": "#/$defs/SavedOnlyReason"
        }
      },
      "required": [
        "reason",
        "profile_name"
      ],
      "type": "object"
    },
    "SavedOnlyReason": {
      "oneOf": [
        {
          "const": "inactive_profile",
          "description": "The change's Profile was not the active one. It takes effect when\nthat Profile is switched to.",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "changes": {
      "items": {
        "$ref": "#/$defs/ChangeSummary"
      },
      "type": "array"
    }
  },
  "required": [
    "changes"
  ],
  "title": "ChangesListOutput",
  "type": "object"
}
