{
  "$defs": {
    "Appearance": {
      "additionalProperties": false,
      "properties": {
        "locale": {
          "type": "string"
        },
        "low_power_style": {
          "default": false,
          "description": "No blur and no shadow; NFR-05 measures it as its own style.",
          "type": "boolean"
        },
        "reduced_motion": {
          "default": false,
          "type": "boolean"
        },
        "reduced_transparency": {
          "default": false,
          "type": "boolean"
        },
        "theme": {
          "type": "string"
        },
        "tokens": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "type": "object"
        }
      },
      "required": [
        "theme",
        "locale"
      ],
      "type": "object"
    },
    "AvatarCorner": {
      "description": "Where on its output the character sits.",
      "enum": [
        "bottom_right",
        "bottom_left",
        "top_right",
        "top_left"
      ],
      "type": "string"
    },
    "AvatarPlacement": {
      "additionalProperties": false,
      "description": "The character's placement as the Shell observes it after laying it out.",
      "properties": {
        "corner": {
          "$ref": "#/$defs/AvatarCorner"
        },
        "follows_primary": {
          "description": "True when the Profile names no output, or names one that is not\nconnected, and the character is on the primary output instead.",
          "type": "boolean"
        },
        "height": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "output": {
          "description": "The output the character's surface is on; absent when it has no\nsurface (turned off, or no output connected).",
          "type": [
            "string",
            "null"
          ]
        },
        "visible": {
          "description": "On screen: false while hidden or turned off.",
          "type": "boolean"
        },
        "width": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "x": {
          "description": "The surface rectangle in logical pixels, relative to `output`.",
          "format": "int32",
          "type": "integer"
        },
        "y": {
          "format": "int32",
          "type": "integer"
        }
      },
      "required": [
        "follows_primary",
        "corner",
        "x",
        "y",
        "width",
        "height",
        "visible"
      ],
      "type": "object"
    },
    "AvatarSettings": {
      "additionalProperties": false,
      "properties": {
        "animations": {
          "default": true,
          "type": "boolean"
        },
        "corner": {
          "$ref": "#/$defs/AvatarCorner",
          "description": "Which corner of that output the character sits in. A corner is always\ninside the visible area, whatever size the output has."
        },
        "enabled": {
          "type": "boolean"
        },
        "hidden": {
          "default": false,
          "type": "boolean"
        },
        "output": {
          "description": "The output the character stays on, by connector name. Absent means\nit follows the primary output; so does a named output that is not\nconnected (unplugged), until it comes back. Absent fields are left out\nof the document, so a Profile written before they existed keeps its\ndigest.",
          "type": [
            "string",
            "null"
          ]
        },
        "scale": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "enabled",
        "scale"
      ],
      "type": "object"
    },
    "ChangePhase": {
      "additionalProperties": false,
      "properties": {
        "change_id": {
          "type": "string"
        },
        "phase": {
          "$ref": "#/$defs/ParticipantPhase"
        }
      },
      "required": [
        "change_id",
        "phase"
      ],
      "type": "object"
    },
    "EntryMode": {
      "enum": [
        "candidate",
        "active"
      ],
      "type": "string"
    },
    "FiberState": {
      "enum": [
        "pending",
        "loading",
        "active",
        "unloading",
        "disposed",
        "failed"
      ],
      "type": "string"
    },
    "HostEntryObservation": {
      "additionalProperties": false,
      "properties": {
        "entry_id": {
          "type": "string"
        },
        "failure": {
          "type": [
            "string",
            "null"
          ]
        },
        "fiber_state": {
          "$ref": "#/$defs/FiberState"
        },
        "mode": {
          "$ref": "#/$defs/EntryMode"
        },
        "waiting_for": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "entry_id",
        "fiber_state",
        "mode"
      ],
      "type": "object"
    },
    "Observation": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "appearance": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Appearance"
                },
                {
                  "type": "null"
                }
              ]
            },
            "approval_responder": {
              "description": "The Shell shows approval requests and can answer them. Without it an\nAgent's approval request is recorded as unavailable at once: nobody\nwould see it, and waiting would only stall the turn.",
              "type": "boolean"
            },
            "avatar": {
              "anyOf": [
                {
                  "$ref": "#/$defs/AvatarSettings"
                },
                {
                  "type": "null"
                }
              ]
            },
            "avatar_placement": {
              "anyOf": [
                {
                  "$ref": "#/$defs/AvatarPlacement"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Where the character actually is, as the Shell laid it out. `avatar`\nabove echoes the settings; this is the readback of their effect."
            },
            "mounts": {
              "items": {
                "$ref": "#/$defs/PanelMount"
              },
              "type": "array"
            },
            "role": {
              "const": "shell",
              "type": "string"
            }
          },
          "required": [
            "role",
            "mounts"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "entries": {
              "items": {
                "$ref": "#/$defs/HostEntryObservation"
              },
              "type": "array"
            },
            "role": {
              "const": "hostd",
              "type": "string"
            }
          },
          "required": [
            "role",
            "entries"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "regions": {
              "description": "Each open window a region rule covers, with where it actually is.",
              "items": {
                "$ref": "#/$defs/RegionPlacement"
              },
              "type": "array"
            },
            "role": {
              "const": "compositor",
              "type": "string"
            },
            "shortcuts": {
              "items": {
                "$ref": "#/$defs/ShortcutBinding"
              },
              "type": "array"
            },
            "strategy": {
              "type": [
                "string",
                "null"
              ]
            },
            "workspace_grid": {
              "items": {
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": [
                "array",
                "null"
              ]
            }
          },
          "required": [
            "role",
            "shortcuts"
          ],
          "type": "object"
        }
      ]
    },
    "PanelMount": {
      "additionalProperties": false,
      "properties": {
        "entry_id": {
          "type": "string"
        },
        "mounted": {
          "type": "boolean"
        },
        "slot": {
          "type": "string"
        },
        "visible": {
          "type": "boolean"
        }
      },
      "required": [
        "slot",
        "entry_id",
        "mounted",
        "visible"
      ],
      "type": "object"
    },
    "ParticipantPhase": {
      "oneOf": [
        {
          "enum": [
            "prepared",
            "committed",
            "aborted",
            "rolled_back"
          ],
          "type": "string"
        },
        {
          "const": "unknown",
          "description": "The participant does not remember this change (it restarted).",
          "type": "string"
        }
      ]
    },
    "RegionPlacement": {
      "additionalProperties": false,
      "description": "One window under a region rule, read back from the compositor.",
      "properties": {
        "observed": {
          "description": "Where the compositor reports it; absent when it cannot say.",
          "items": {
            "format": "int64",
            "type": "integer"
          },
          "maxItems": 4,
          "minItems": 4,
          "type": [
            "array",
            "null"
          ]
        },
        "rule_id": {
          "type": "string"
        },
        "target": {
          "description": "Where the rule puts it, in output-relative logical pixels.",
          "items": {
            "format": "int64",
            "type": "integer"
          },
          "maxItems": 4,
          "minItems": 4,
          "type": "array"
        },
        "window_id": {
          "type": "string"
        }
      },
      "required": [
        "rule_id",
        "window_id",
        "target"
      ],
      "type": "object"
    },
    "ShortcutBinding": {
      "additionalProperties": false,
      "properties": {
        "chord": {
          "type": "string"
        },
        "command": {
          "type": "string"
        }
      },
      "required": [
        "chord",
        "command"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "change": {
      "anyOf": [
        {
          "$ref": "#/$defs/ChangePhase"
        },
        {
          "type": "null"
        }
      ]
    },
    "observed": {
      "$ref": "#/$defs/Observation"
    }
  },
  "required": [
    "observed"
  ],
  "title": "StateOutput",
  "type": "object"
}
