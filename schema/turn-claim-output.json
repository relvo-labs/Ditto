{
  "$defs": {
    "AgentPreferences": {
      "additionalProperties": false,
      "properties": {
        "auth": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderAuthentication"
            },
            {
              "type": "null"
            }
          ]
        },
        "enabled": {
          "type": "boolean"
        },
        "max_tool_calls": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "provider": {
          "type": "string"
        },
        "reasoning_effort": {
          "type": [
            "string",
            "null"
          ]
        },
        "retain_conversations": {
          "type": "boolean"
        },
        "revision": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "turn_timeout_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "revision",
        "enabled",
        "provider",
        "max_tool_calls",
        "turn_timeout_ms",
        "retain_conversations"
      ],
      "type": "object"
    },
    "ChangeState": {
      "enum": [
        "draft",
        "validated",
        "rejected",
        "prepared",
        "aborted",
        "applying",
        "verifying",
        "committed",
        "rolling_back",
        "rolled_back",
        "partially_applied",
        "unknown"
      ],
      "type": "string"
    },
    "DiffItem": {
      "additionalProperties": false,
      "description": "One line of a change card. The label is a translation key so Core never\nemits locale-specific text; the Shell renders it in the Profile's language.",
      "properties": {
        "after": true,
        "before": true,
        "kind": {
          "$ref": "#/$defs/DiffKind"
        },
        "label_args": {
          "additionalProperties": true,
          "default": {},
          "type": "object"
        },
        "label_key": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "kind",
        "label_key"
      ],
      "type": "object"
    },
    "DiffKind": {
      "enum": [
        "added",
        "removed",
        "changed"
      ],
      "type": "string"
    },
    "ProviderAuthentication": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "connection_ref": {
              "type": "string"
            },
            "kind": {
              "const": "codex_subscription",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "connection_ref"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "credential_ref": {
              "type": "string"
            },
            "kind": {
              "const": "api_key",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "credential_ref"
          ],
          "type": "object"
        }
      ]
    },
    "RecentChange": {
      "additionalProperties": false,
      "properties": {
        "change_id": {
          "type": "string"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/DiffItem"
          },
          "type": "array"
        },
        "result": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResultKind"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "$ref": "#/$defs/ChangeState"
        },
        "turn_id": {
          "type": "string"
        }
      },
      "required": [
        "change_id",
        "turn_id",
        "state",
        "items"
      ],
      "type": "object"
    },
    "ResultKind": {
      "oneOf": [
        {
          "enum": [
            "succeeded",
            "failed",
            "partial",
            "unknown"
          ],
          "type": "string"
        },
        {
          "const": "scheduled",
          "description": "Committed as a revision, but nothing took effect yet: every item is\n`scheduled` (session-restart level: at the next login; in rescue mode:\nwhen the normal mode returns). Never presented as \"applied\".",
          "type": "string"
        }
      ]
    },
    "Turn": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "type": "string"
        },
        "error_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "operation_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "session_id": {
          "type": "string"
        },
        "settings_revision": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "state": {
          "$ref": "#/$defs/TurnState"
        },
        "tool_calls": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "turn_id": {
          "type": "string"
        }
      },
      "required": [
        "turn_id",
        "session_id",
        "state",
        "created_at",
        "settings_revision",
        "tool_calls",
        "operation_ids"
      ],
      "type": "object"
    },
    "TurnState": {
      "enum": [
        "queued",
        "running",
        "awaiting_approval",
        "cancelling",
        "succeeded",
        "failed",
        "partial",
        "unknown",
        "cancelled"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "message_seq": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "recent_changes": {
      "default": [],
      "description": "The latest ChangeSets this conversation produced, newest first, as\nCore recorded them: what \"that\", \"it\" or \"a bit more\" can refer to.",
      "items": {
        "$ref": "#/$defs/RecentChange"
      },
      "type": "array"
    },
    "settings": {
      "$ref": "#/$defs/AgentPreferences"
    },
    "text": {
      "type": "string"
    },
    "turn": {
      "$ref": "#/$defs/Turn"
    }
  },
  "required": [
    "turn",
    "text",
    "message_seq",
    "settings"
  ],
  "title": "TurnClaimOutput",
  "type": "object"
}
