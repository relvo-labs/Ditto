{
  "$defs": {
    "ProviderLoginState": {
      "enum": [
        "pending",
        "succeeded",
        "failed",
        "cancelled",
        "expired",
        "unknown"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "generation": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "login_id": {
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/ProviderLoginState"
    }
  },
  "required": [
    "login_id",
    "generation",
    "state"
  ],
  "title": "ProviderLoginResult",
  "type": "object"
}
