{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "auth_url": {
      "description": "The device-code verification page the person opens in a browser.",
      "type": "string"
    },
    "expires_at_ms": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "login_id": {
      "type": "string"
    },
    "user_code": {
      "description": "The one-time code the person enters on that page.",
      "type": "string"
    }
  },
  "required": [
    "login_id",
    "auth_url",
    "user_code",
    "expires_at_ms"
  ],
  "title": "ProviderLoginOutput",
  "type": "object"
}
