{
  "$defs": {
    "Appearance": {
      "additionalProperties": false,
      "properties": {
        "locale": {
          "type": "string"
        },
        "low_power_style": {
          "default": false,
          "description": "No blur and no shadow; NFR-05 measures it as its own style.",
          "type": "boolean"
        },
        "reduced_motion": {
          "default": false,
          "type": "boolean"
        },
        "reduced_transparency": {
          "default": false,
          "type": "boolean"
        },
        "theme": {
          "type": "string"
        },
        "tokens": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "type": "object"
        }
      },
      "required": [
        "theme",
        "locale"
      ],
      "type": "object"
    },
    "AvatarCorner": {
      "description": "Where on its output the character sits.",
      "enum": [
        "bottom_right",
        "bottom_left",
        "top_right",
        "top_left"
      ],
      "type": "string"
    },
    "AvatarPresentation": {
      "description": "An explicit rendering choice; absence retains the optional legacy avatar.",
      "enum": [
        "assistant"
      ],
      "type": "string"
    },
    "AvatarSettings": {
      "additionalProperties": false,
      "properties": {
        "animations": {
          "default": true,
          "type": "boolean"
        },
        "corner": {
          "$ref": "#/$defs/AvatarCorner",
          "description": "Which corner of that output the character sits in. A corner is always\ninside the visible area, whatever size the output has."
        },
        "enabled": {
          "type": "boolean"
        },
        "hidden": {
          "default": false,
          "type": "boolean"
        },
        "output": {
          "description": "The output the character stays on, by connector name. Absent means\nit follows the primary output; so does a named output that is not\nconnected (unplugged), until it comes back. Absent fields are left out\nof the document, so a Profile written before they existed keeps its\ndigest.",
          "type": [
            "string",
            "null"
          ]
        },
        "presentation": {
          "anyOf": [
            {
              "$ref": "#/$defs/AvatarPresentation"
            },
            {
              "type": "null"
            }
          ],
          "description": "D-48: absent preserves legacy rendering and its document digest.\nOlder readers reject this field; see the explicit downgrade policy."
        },
        "scale": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "enabled",
        "scale"
      ],
      "type": "object"
    },
    "EntrySpec": {
      "additionalProperties": false,
      "properties": {
        "area": {
          "description": "The multi-entry area this entry is a member of (one of `AREAS`).\nAbsent means none, and is left out of the document, so a Profile\nwritten before areas existed keeps its digest.",
          "type": [
            "string",
            "null"
          ]
        },
        "config": {
          "default": {}
        },
        "disabled": {
          "default": false,
          "type": "boolean"
        },
        "entry_id": {
          "description": "`ent-<ULID>`, generated by Core and stable across revisions: without a\nstable id every edit would look like a removal plus an addition.",
          "type": "string"
        },
        "host": {
          "$ref": "#/$defs/HostKind"
        },
        "package": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "entry_id",
        "package",
        "version",
        "host"
      ],
      "type": "object"
    },
    "HostKind": {
      "enum": [
        "qml",
        "cordis",
        "core_builtin"
      ],
      "type": "string"
    },
    "LayoutIntent": {
      "additionalProperties": false,
      "description": "Layout intent. Which strategy applies is the `layout.strategy` slot.",
      "properties": {
        "regions": {
          "description": "Where windows of an application go, as a share of their output's work\narea (D-40). Applied to the windows open when the change commits and to\nthose that open later; moving a window by hand afterwards is respected\nuntil the next explicit change. Floating strategy only.",
          "items": {
            "$ref": "#/$defs/RegionRule"
          },
          "type": "array"
        },
        "rules": {
          "default": [],
          "items": {
            "$ref": "#/$defs/LayoutRule"
          },
          "type": "array"
        },
        "workspace_grid": {
          "items": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        }
      },
      "required": [
        "workspace_grid"
      ],
      "type": "object"
    },
    "LayoutMatch": {
      "additionalProperties": false,
      "properties": {
        "app_id": {
          "type": "string"
        }
      },
      "required": [
        "app_id"
      ],
      "type": "object"
    },
    "LayoutRule": {
      "additionalProperties": false,
      "properties": {
        "match": {
          "$ref": "#/$defs/LayoutMatch"
        },
        "workspace": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "match",
        "workspace"
      ],
      "type": "object"
    },
    "Region": {
      "additionalProperties": false,
      "description": "A rectangle as fractions (0–1) of an output's work area.",
      "properties": {
        "height": {
          "format": "double",
          "type": "number"
        },
        "width": {
          "format": "double",
          "type": "number"
        },
        "x": {
          "format": "double",
          "type": "number"
        },
        "y": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "type": "object"
    },
    "RegionRule": {
      "additionalProperties": false,
      "properties": {
        "match": {
          "$ref": "#/$defs/LayoutMatch"
        },
        "output": {
          "description": "The output whose work area the region divides; absent means the\noutput the window is on.",
          "type": [
            "string",
            "null"
          ]
        },
        "region": {
          "$ref": "#/$defs/Region"
        },
        "rule_id": {
          "description": "Stable within the Profile, so a later turn can name \"the same rule\".",
          "type": "string"
        }
      },
      "required": [
        "rule_id",
        "match",
        "region"
      ],
      "type": "object"
    },
    "ShortcutBinding": {
      "additionalProperties": false,
      "properties": {
        "chord": {
          "type": "string"
        },
        "command": {
          "type": "string"
        }
      },
      "required": [
        "chord",
        "command"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "appearance": {
      "$ref": "#/$defs/Appearance"
    },
    "avatar": {
      "$ref": "#/$defs/AvatarSettings"
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/EntrySpec"
      },
      "type": "array"
    },
    "layout": {
      "$ref": "#/$defs/LayoutIntent"
    },
    "schema_version": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "shortcuts": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ShortcutBinding"
      },
      "type": "array"
    },
    "slots": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "slot name → entry id.",
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "entries",
    "slots",
    "layout",
    "appearance",
    "avatar"
  ],
  "title": "ProfileDocument",
  "type": "object"
}
