{
  "$defs": {
    "EventTopic": {
      "oneOf": [
        {
          "enum": [
            "desktop",
            "changes",
            "plugins",
            "notifications",
            "tasks",
            "session"
          ],
          "type": "string"
        },
        {
          "const": "conversations",
          "description": "Conversation and turn progress. Ids and states only: the content is\nread through `agent.sessions.read`, under that capability's own scope.",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "after_seq": {
      "format": "uint64",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "topics": {
      "description": "Absent means `[\"desktop\"]`, the G0 stream. Each topic needs its own\nscope, so asking for more than the caller may read is refused whole.",
      "items": {
        "$ref": "#/$defs/EventTopic"
      },
      "type": [
        "array",
        "null"
      ]
    }
  },
  "title": "EventsSubscribeInput",
  "type": "object"
}
