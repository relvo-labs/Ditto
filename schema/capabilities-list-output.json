{
  "$defs": {
    "Availability": {
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "always",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "description": "Resolved when Core runs; the exported catalog cannot know it, so it\nnames the capability-matrix row or the provider slot instead.",
          "properties": {
            "kind": {
              "const": "resolved_at_runtime",
              "type": "string"
            },
            "matrix_row": {
              "type": [
                "string",
                "null"
              ]
            },
            "slot": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "properties": {
            "available": {
              "type": "boolean"
            },
            "bound_to": {
              "description": "Compositor-specific path this capability is bound to, when no\nneutral Wayland protocol covers it.",
              "type": [
                "string",
                "null"
              ]
            },
            "kind": {
              "const": "depends_on_compositor",
              "type": "string"
            },
            "matrix_row": {
              "type": "string"
            },
            "reason": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind",
            "matrix_row",
            "available"
          ],
          "type": "object"
        },
        {
          "properties": {
            "available": {
              "type": "boolean"
            },
            "entry_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "kind": {
              "const": "depends_on_provider",
              "type": "string"
            },
            "reason": {
              "anyOf": [
                {
                  "$ref": "#/$defs/UnavailableReason"
                },
                {
                  "type": "null"
                }
              ]
            },
            "slot": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "slot",
            "available"
          ],
          "type": "object"
        },
        {
          "properties": {
            "available": {
              "type": "boolean"
            },
            "component": {
              "type": "string"
            },
            "kind": {
              "const": "depends_on_system",
              "type": "string"
            },
            "reason": {
              "anyOf": [
                {
                  "$ref": "#/$defs/UnavailableReason"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "kind",
            "component",
            "available"
          ],
          "type": "object"
        }
      ]
    },
    "CapabilityDescriptor": {
      "additionalProperties": false,
      "description": "A capability contract. `availability` is the only runtime-resolved field:\nthe exported catalog declares what a capability depends on (a matrix row\nor a provider slot), and Core fills in what is actually offered.",
      "properties": {
        "availability": {
          "$ref": "#/$defs/Availability"
        },
        "cancellable": {
          "type": "boolean"
        },
        "capability_id": {
          "type": "string"
        },
        "claimable": {
          "type": "boolean"
        },
        "errors": {
          "items": {
            "$ref": "#/$defs/ErrorName"
          },
          "type": "array"
        },
        "idempotency": {
          "$ref": "#/$defs/Idempotency"
        },
        "input_schema": true,
        "output_schema": true,
        "provider": {
          "description": "`core`, `compositor-adapter`, `system`, `shell` or `hostd`; the\nserved catalog names the entry: `hostd:<entry_id>`.",
          "type": "string"
        },
        "readback": {
          "type": [
            "string",
            "null"
          ]
        },
        "resource_scope": {
          "description": "Never empty from 0.2 on: every call goes through one authorization\nentry point, and an empty scope would be an unreviewed default.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "timeout_ms": {
          "$ref": "#/$defs/Timeout"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "capability_id",
        "version",
        "input_schema",
        "output_schema",
        "errors",
        "resource_scope",
        "cancellable",
        "idempotency",
        "timeout_ms",
        "claimable",
        "provider",
        "availability"
      ],
      "type": "object"
    },
    "ErrorName": {
      "enum": [
        "unsupported",
        "invalid_params",
        "not_found",
        "permission_denied",
        "timeout",
        "cancelled",
        "conflict",
        "unavailable",
        "protocol_version_unsupported",
        "identity_rejected",
        "preflight_rejected",
        "internal"
      ],
      "type": "string"
    },
    "Idempotency": {
      "enum": [
        "none",
        "key-based",
        "natural"
      ],
      "type": "string"
    },
    "Timeout": {
      "additionalProperties": false,
      "properties": {
        "default_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "max_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "default_ms",
        "max_ms"
      ],
      "type": "object"
    },
    "UnavailableReason": {
      "description": "Why a capability or a call is unavailable. Closed: a consumer can show a\nspecific product sentence for every value.",
      "oneOf": [
        {
          "enum": [
            "compositor_offline",
            "host_unavailable",
            "host_crash_loop",
            "lease_expired",
            "not_bound",
            "rescue_mode",
            "recovering",
            "system_unavailable",
            "participant_unavailable",
            "session_locked"
          ],
          "type": "string"
        },
        {
          "const": "storage_full",
          "description": "The store refused the write for lack of space; nothing changed.",
          "type": "string"
        },
        {
          "const": "storage_error",
          "description": "The store reported an I/O error; nothing changed.",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "capabilities": {
      "items": {
        "$ref": "#/$defs/CapabilityDescriptor"
      },
      "type": "array"
    },
    "catalog_revision": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "catalog_revision",
    "capabilities"
  ],
  "title": "CapabilitiesListOutput",
  "type": "object"
}
