{
  "$defs": {
    "Coalesce": {
      "enum": [
        "none",
        "latest"
      ],
      "type": "string"
    },
    "CommandDecl": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "title_key": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title_key"
      ],
      "type": "object"
    },
    "EventDecl": {
      "additionalProperties": false,
      "properties": {
        "coalesce": {
          "$ref": "#/$defs/Coalesce"
        },
        "name": {
          "type": "string"
        },
        "schema": true
      },
      "required": [
        "name",
        "schema",
        "coalesce"
      ],
      "type": "object"
    },
    "HostKind": {
      "enum": [
        "qml",
        "cordis",
        "core_builtin"
      ],
      "type": "string"
    },
    "HotSwapLevel": {
      "enum": [
        "instant",
        "controlled_handoff",
        "host_restart",
        "session_restart"
      ],
      "type": "string"
    },
    "IdlePolicy": {
      "enum": [
        "resident",
        "on_demand"
      ],
      "type": "string"
    },
    "Item": {
      "additionalProperties": false,
      "description": "What a package provides or depends on. Exactly one field is set.",
      "properties": {
        "capability": {
          "type": [
            "string",
            "null"
          ]
        },
        "package": {
          "type": [
            "string",
            "null"
          ]
        },
        "service": {
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "description": "semver range, for `package` dependencies.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "Manifest": {
      "additionalProperties": false,
      "properties": {
        "activation_events": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "author": {
          "type": "string"
        },
        "cleanup": {
          "$ref": "#/$defs/TimeoutDecl"
        },
        "commands": {
          "default": [],
          "items": {
            "$ref": "#/$defs/CommandDecl"
          },
          "type": "array"
        },
        "config_schema": {
          "default": {
            "type": "object"
          }
        },
        "conflicts": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "data_schema": true,
        "description": true,
        "entry": {
          "type": [
            "string",
            "null"
          ]
        },
        "events": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EventDecl"
          },
          "type": "array"
        },
        "health": {
          "$ref": "#/$defs/TimeoutDecl"
        },
        "host_kind": {
          "$ref": "#/$defs/HostKind"
        },
        "hot_swap": {
          "$ref": "#/$defs/HotSwapLevel"
        },
        "id": {
          "type": "string"
        },
        "idle_policy": {
          "$ref": "#/$defs/IdlePolicy"
        },
        "license": {
          "type": "string"
        },
        "manifest_version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "migrations": {
          "default": [],
          "items": true,
          "type": "array"
        },
        "name": {
          "description": "A string, or a `{ locale: text }` object."
        },
        "optional": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Item"
          },
          "type": "array"
        },
        "permissions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "platform": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "plugin_kind": {
          "$ref": "#/$defs/PluginKind"
        },
        "provides": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Item"
          },
          "type": "array"
        },
        "qml_entry": {
          "type": [
            "string",
            "null"
          ]
        },
        "required_protocol_version": {
          "type": "string"
        },
        "requires": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Item"
          },
          "type": "array"
        },
        "rescue": {
          "$ref": "#/$defs/RescueDecl",
          "default": {
            "disable_safe": false
          }
        },
        "resource_budget": {
          "$ref": "#/$defs/ResourceBudget",
          "default": {}
        },
        "runtime": {
          "$ref": "#/$defs/RuntimeRequirement",
          "default": {}
        },
        "shortcuts": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ShortcutDecl"
          },
          "type": "array"
        },
        "slots": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "source": {
          "type": "string"
        },
        "trust_level": {
          "$ref": "#/$defs/TrustLevel"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "manifest_version",
        "id",
        "version",
        "name",
        "author",
        "license",
        "source",
        "plugin_kind",
        "host_kind",
        "trust_level",
        "required_protocol_version",
        "hot_swap",
        "health",
        "cleanup",
        "idle_policy"
      ],
      "type": "object"
    },
    "PackageSummary": {
      "additionalProperties": false,
      "properties": {
        "author": {
          "type": "string"
        },
        "host_kind": {
          "$ref": "#/$defs/HostKind"
        },
        "installed_at": {
          "type": "string"
        },
        "license": {
          "type": "string"
        },
        "name": true,
        "package_id": {
          "type": "string"
        },
        "plugin_kind": {
          "$ref": "#/$defs/PluginKind"
        },
        "referenced_by": {
          "description": "Retained revisions that pin this package; it cannot be removed while\nany exists.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "sha256": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "trust_level": {
          "$ref": "#/$defs/TrustLevel"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "package_id",
        "version",
        "sha256",
        "source",
        "name",
        "author",
        "license",
        "plugin_kind",
        "host_kind",
        "trust_level",
        "installed_at",
        "referenced_by"
      ],
      "type": "object"
    },
    "PluginKind": {
      "enum": [
        "service",
        "qml_provider",
        "declarative_bundle"
      ],
      "type": "string"
    },
    "RescueDecl": {
      "additionalProperties": false,
      "properties": {
        "disable_safe": {
          "default": false,
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "ResourceBudget": {
      "additionalProperties": false,
      "properties": {
        "cpu_percent": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "memory_mib": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "RuntimeRequirement": {
      "additionalProperties": false,
      "properties": {
        "node": {
          "type": [
            "string",
            "null"
          ]
        },
        "qt": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "ShortcutDecl": {
      "additionalProperties": false,
      "properties": {
        "chord": {
          "type": "string"
        },
        "command": {
          "type": "string"
        }
      },
      "required": [
        "chord",
        "command"
      ],
      "type": "object"
    },
    "TimeoutDecl": {
      "additionalProperties": false,
      "properties": {
        "timeout_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "timeout_ms"
      ],
      "type": "object"
    },
    "TrustLevel": {
      "enum": [
        "trusted",
        "community",
        "untrusted"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "manifest": {
      "$ref": "#/$defs/Manifest"
    },
    "package": {
      "$ref": "#/$defs/PackageSummary"
    },
    "versions": {
      "description": "Every installed version of this package id.",
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "package",
    "manifest",
    "versions"
  ],
  "title": "PluginsGetOutput",
  "type": "object"
}
