{
  "$defs": {
    "Appearance": {
      "additionalProperties": false,
      "properties": {
        "locale": {
          "type": "string"
        },
        "low_power_style": {
          "default": false,
          "description": "No blur and no shadow; NFR-05 measures it as its own style.",
          "type": "boolean"
        },
        "reduced_motion": {
          "default": false,
          "type": "boolean"
        },
        "reduced_transparency": {
          "default": false,
          "type": "boolean"
        },
        "theme": {
          "type": "string"
        },
        "tokens": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "type": "object"
        }
      },
      "required": [
        "theme",
        "locale"
      ],
      "type": "object"
    },
    "AvatarCorner": {
      "description": "Where on its output the character sits.",
      "enum": [
        "bottom_right",
        "bottom_left",
        "top_right",
        "top_left"
      ],
      "type": "string"
    },
    "AvatarSettings": {
      "additionalProperties": false,
      "properties": {
        "animations": {
          "default": true,
          "type": "boolean"
        },
        "corner": {
          "$ref": "#/$defs/AvatarCorner",
          "description": "Which corner of that output the character sits in. A corner is always\ninside the visible area, whatever size the output has."
        },
        "enabled": {
          "type": "boolean"
        },
        "hidden": {
          "default": false,
          "type": "boolean"
        },
        "output": {
          "description": "The output the character stays on, by connector name. Absent means\nit follows the primary output; so does a named output that is not\nconnected (unplugged), until it comes back. Absent fields are left out\nof the document, so a Profile written before they existed keeps its\ndigest.",
          "type": [
            "string",
            "null"
          ]
        },
        "scale": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "enabled",
        "scale"
      ],
      "type": "object"
    },
    "EntrySpec": {
      "additionalProperties": false,
      "properties": {
        "area": {
          "description": "The multi-entry area this entry is a member of (one of `AREAS`).\nAbsent means none, and is left out of the document, so a Profile\nwritten before areas existed keeps its digest.",
          "type": [
            "string",
            "null"
          ]
        },
        "config": {
          "default": {}
        },
        "disabled": {
          "default": false,
          "type": "boolean"
        },
        "entry_id": {
          "description": "`ent-<ULID>`, generated by Core and stable across revisions: without a\nstable id every edit would look like a removal plus an addition.",
          "type": "string"
        },
        "host": {
          "$ref": "#/$defs/HostKind"
        },
        "package": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "entry_id",
        "package",
        "version",
        "host"
      ],
      "type": "object"
    },
    "HostKind": {
      "enum": [
        "qml",
        "cordis",
        "core_builtin"
      ],
      "type": "string"
    },
    "LayoutIntent": {
      "additionalProperties": false,
      "description": "Layout intent. Which strategy applies is the `layout.strategy` slot.",
      "properties": {
        "rules": {
          "default": [],
          "items": {
            "$ref": "#/$defs/LayoutRule"
          },
          "type": "array"
        },
        "workspace_grid": {
          "items": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        }
      },
      "required": [
        "workspace_grid"
      ],
      "type": "object"
    },
    "LayoutMatch": {
      "additionalProperties": false,
      "properties": {
        "app_id": {
          "type": "string"
        }
      },
      "required": [
        "app_id"
      ],
      "type": "object"
    },
    "LayoutRule": {
      "additionalProperties": false,
      "properties": {
        "match": {
          "$ref": "#/$defs/LayoutMatch"
        },
        "workspace": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "match",
        "workspace"
      ],
      "type": "object"
    },
    "ProfileDocument": {
      "additionalProperties": false,
      "properties": {
        "appearance": {
          "$ref": "#/$defs/Appearance"
        },
        "avatar": {
          "$ref": "#/$defs/AvatarSettings"
        },
        "entries": {
          "items": {
            "$ref": "#/$defs/EntrySpec"
          },
          "type": "array"
        },
        "layout": {
          "$ref": "#/$defs/LayoutIntent"
        },
        "schema_version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "shortcuts": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ShortcutBinding"
          },
          "type": "array"
        },
        "slots": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "slot name → entry id.",
          "type": "object"
        }
      },
      "required": [
        "schema_version",
        "entries",
        "slots",
        "layout",
        "appearance",
        "avatar"
      ],
      "type": "object"
    },
    "ProfileSummary": {
      "additionalProperties": false,
      "properties": {
        "active": {
          "type": "boolean"
        },
        "created_at": {
          "type": "string"
        },
        "head_revision": {
          "type": "string"
        },
        "last_known_good": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "profile_id": {
          "type": "string"
        },
        "updated_at": {
          "type": "string"
        }
      },
      "required": [
        "profile_id",
        "name",
        "head_revision",
        "active",
        "created_at",
        "updated_at"
      ],
      "type": "object"
    },
    "RevisionOrigin": {
      "oneOf": [
        {
          "description": "Created from the built-in default or an empty document.",
          "properties": {
            "from": {
              "type": "string"
            },
            "kind": {
              "const": "create",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "from"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "duplicate",
              "type": "string"
            },
            "source_revision": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "source_revision"
          ],
          "type": "object"
        },
        {
          "properties": {
            "change_id": {
              "type": "string"
            },
            "kind": {
              "const": "change",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "change_id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "import",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "description": "Written by `dittoctl rescue` while Core was not running.",
          "properties": {
            "action": {
              "type": "string"
            },
            "kind": {
              "const": "rescue_offline",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "action"
          ],
          "type": "object"
        },
        {
          "properties": {
            "action": {
              "type": "string"
            },
            "kind": {
              "const": "rescue",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "action"
          ],
          "type": "object"
        }
      ]
    },
    "RevisionSummary": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "type": "string"
        },
        "document_sha256": {
          "type": "string"
        },
        "last_known_good": {
          "default": false,
          "type": "boolean"
        },
        "origin": {
          "$ref": "#/$defs/RevisionOrigin"
        },
        "parent": {
          "type": [
            "string",
            "null"
          ]
        },
        "pending_confirmation": {
          "default": false,
          "description": "Committed and inside a timed-revert or preview window.",
          "type": "boolean"
        },
        "profile_id": {
          "type": "string"
        },
        "revision_id": {
          "type": "string"
        },
        "unstable": {
          "default": false,
          "description": "A supervisor restart or a failed entry happened in the observation\nperiod after this revision was committed.",
          "type": "boolean"
        }
      },
      "required": [
        "revision_id",
        "profile_id",
        "document_sha256",
        "origin",
        "created_at"
      ],
      "type": "object"
    },
    "ShortcutBinding": {
      "additionalProperties": false,
      "properties": {
        "chord": {
          "type": "string"
        },
        "command": {
          "type": "string"
        }
      },
      "required": [
        "chord",
        "command"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "document": {
      "$ref": "#/$defs/ProfileDocument"
    },
    "history": {
      "description": "Newest first, along the parent chain of `revision`.",
      "items": {
        "$ref": "#/$defs/RevisionSummary"
      },
      "type": "array"
    },
    "profile": {
      "$ref": "#/$defs/ProfileSummary"
    },
    "revision": {
      "$ref": "#/$defs/RevisionSummary"
    }
  },
  "required": [
    "profile",
    "revision",
    "document",
    "history"
  ],
  "title": "ProfilesGetOutput",
  "type": "object"
}
