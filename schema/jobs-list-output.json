{
  "$defs": {
    "Job": {
      "additionalProperties": false,
      "properties": {
        "cancellable": {
          "default": false,
          "description": "Whether `desktop.jobs.cancel` can stop it now.",
          "type": "boolean"
        },
        "created_at": {
          "type": "string"
        },
        "error_key": {
          "type": [
            "string",
            "null"
          ]
        },
        "idempotency_key": {
          "type": [
            "string",
            "null"
          ]
        },
        "job_id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "owner": {
          "description": "The subject that submitted it (`agent`, `shell`, `cli`); Core owns\nthe job from then on, whoever leaves.",
          "type": [
            "string",
            "null"
          ]
        },
        "phase": {
          "description": "What the worker reports it is doing (`hashing 3/12`, …).",
          "type": [
            "string",
            "null"
          ]
        },
        "progress": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "result": true,
        "state": {
          "$ref": "#/$defs/JobState"
        },
        "updated_at": {
          "type": "string"
        }
      },
      "required": [
        "job_id",
        "kind",
        "state",
        "created_at",
        "updated_at"
      ],
      "type": "object"
    },
    "JobState": {
      "oneOf": [
        {
          "enum": [
            "queued",
            "running",
            "succeeded",
            "failed",
            "cancelled"
          ],
          "type": "string"
        },
        {
          "const": "cancelling",
          "description": "Cancel was asked of a running job; it ends `cancelled` once its\nworker is gone (or with its real outcome if that came first).",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "jobs": {
      "items": {
        "$ref": "#/$defs/Job"
      },
      "type": "array"
    }
  },
  "required": [
    "jobs"
  ],
  "title": "JobsListOutput",
  "type": "object"
}
