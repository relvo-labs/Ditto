        },
        "error_key": {
          "type": [
            "string",
            "null"
          ]
        },
        "idempotency_key": {
          "type": [
            "string",
            "null"
          ]
        },
        "job_id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "progress": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "result": true,
        "state": {
          "$ref": "#/$defs/JobState"
        },
        "updated_at": {
          "type": "string"
        }
      },
