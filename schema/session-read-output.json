{
  "$defs": {
    "Conversation": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "type": "string"
        },
        "durable_seq": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "format_version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "next_seq": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "session_id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "session_id",
        "format_version",
        "title",
        "created_at",
        "next_seq",
        "durable_seq"
      ],
      "type": "object"
    },
    "SessionEvent": {
      "additionalProperties": false,
      "properties": {
        "data": true,
        "seq": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "type": {
          "$ref": "#/$defs/SessionEventKind"
        }
      },
      "required": [
        "seq",
        "type",
        "data"
      ],
      "type": "object"
    },
    "SessionEventKind": {
      "description": "Restricted Harness vocabulary (pinned 477b4f4); unknown required events\nrefuse decoding rather than silently reconstructing a different history.",
      "enum": [
        "user/message",
        "assistant/message",
        "turn/start",
        "turn/end",
        "tool/call",
        "tool/result",
        "approval/asked",
        "approval/decided",
        "model/selection",
        "compaction/summary",
        "session/title",
        "request/context"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "events": {
      "items": {
        "$ref": "#/$defs/SessionEvent"
      },
      "type": "array"
    },
    "session": {
      "$ref": "#/$defs/Conversation"
    }
  },
  "required": [
    "session",
    "events"
  ],
  "title": "SessionReadOutput",
  "type": "object"
}
