{
  "manifest_version": 1,
  "id": "ditto.fixture.realm_cycle",
  "version": "1.0.0",
  "name": {
    "zh-TW": "壓力夾具：realm 往返",
    "en": "Stress fixture: realm cycle"
  },
  "author": "Ditto",
  "license": "MIT",
  "source": "builtin",
  "description": "在 isolate realm 中掛載與撤除（EX1-04 ③、L-04；測試夾具，不隨產品出貨）",
  "plugin_kind": "service",
  "host_kind": "cordis",
  "trust_level": "trusted",
  "runtime": {
    "node": "^22.19.0"
  },
  "platform": [
    "linux-x86_64"
  ],
  "required_protocol_version": "^0.3",
  "slots": [],
  "provides": [
    {
      "capability": "plugin.ditto.fixture.realm_cycle.get"
    }
  ],
  "requires": [],
  "optional": [],
  "conflicts": [],
  "config_schema": {
    "type": "object",
    "properties": {
      "refuse_as_candidate": {
        "type": "boolean",
        "default": false
      },
      "timers": {
        "type": "integer",
        "minimum": 0,
        "maximum": 8,
        "default": 2
      }
    },
    "additionalProperties": false
  },
  "commands": [],
  "shortcuts": [],
  "events": [],
  "permissions": [],
  "hot_swap": "controlled_handoff",
  "health": {
    "timeout_ms": 2000
  },
  "cleanup": {
    "timeout_ms": 5000
  },
  "activation_events": [],
  "idle_policy": "resident",
  "resource_budget": {
    "memory_mib": 8,
    "cpu_percent": 1
  },
  "rescue": {
    "disable_safe": true
  },
  "entry": "dist/index.mjs"
}
