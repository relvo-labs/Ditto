{
  "manifest_version": 1,
  "id": "ditto.template.dock",
  "version": "0.1.0",
  "name": { "zh-TW": "工作列範本", "en": "Dock template" },
  "author": "（作者名稱）",
  "license": "MIT",
  "source": "builtin",
  "description": "QML 供應者範本：換掉 id、名稱與 qml/ 內容即可",
  "plugin_kind": "qml_provider",
  "host_kind": "qml",
  "trust_level": "trusted",
  "runtime": { "qt": ">=6.10" },
  "platform": ["linux-x86_64"],
  "required_protocol_version": "^0.3",
  "slots": ["ui.dock"],
  "provides": [],
  "requires": [],
  "optional": [],
  "conflicts": [],
  "qml_entry": "qml/TemplateDock.qml",
  "config_schema": {
    "type": "object",
    "properties": { "icon_size": { "type": "integer", "minimum": 24, "maximum": 96, "default": 40 } },
    "additionalProperties": false
  },
  "commands": [],
  "shortcuts": [],
  "events": [],
  "permissions": [],
  "hot_swap": "instant",
  "health": { "timeout_ms": 2000 },
  "cleanup": { "timeout_ms": 5000 },
  "activation_events": [],
  "idle_policy": "resident",
  "resource_budget": { "memory_mib": 8, "cpu_percent": 2 },
  "rescue": { "disable_safe": true }
}
