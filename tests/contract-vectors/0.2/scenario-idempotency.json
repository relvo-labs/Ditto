  {"send": {"method": "desktop.changes.propose", "params": {"base_revision": "$head", "idempotency_key": "vector-idem-1", "ops": [{"op": "set_value", "path": "/avatar/hidden", "after": true}]}}, "expect": {"result_path": "/change_id", "equals": "$prev./change_id"}}
 ]}
